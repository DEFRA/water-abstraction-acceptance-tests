# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# IDE's and text editors #
# Ruby mine
/.idea
# VS Code
/.vscode/extensions.json
/.vscode/settings.json
# Symbol tags (e.g. generated by Atom Editor)
/tags

# Logs, temp and OS specific files
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
*~
.DS_Store
.svn
.*.swp
___*
pkg/
chromedriver.log
/.byebug_history
*.log

# Dependency directories
node_modules/

# Ignore our environment config files as they contain actual credentials.
# The example.json is retained as it is used for documentation.
# The ci.json is retained to support our automated CI build.
/environments/*
!/environments/ci.json
!/environments/example.json

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/

# Ignore the .env file as this may contain actual credentials. The .env.example
# is retained as it is used for documentation.
.env
.env.local
