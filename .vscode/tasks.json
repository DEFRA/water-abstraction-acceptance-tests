{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "📺 Open (Tests)",
      "detail": "Open Playwright test UI to manually run its tests",
      "type": "shell",
      "command": "npm run open; echo 'All done! 🎉'",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "📻 Run (Tests)",
      "detail": "Run Playwright tests headless using the runner",
      "type": "shell",
      "command": "npm test; echo 'All done! 🎉'",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "🔁 Retry failed (Tests)",
