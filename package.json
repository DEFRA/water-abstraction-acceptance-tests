{
  "name": "water-abstraction-acceptance-tests",
  "version": "1.0.0",
  "description": "Automated acceptance tests for the Water Abstraction Service",
  "homepage": "https://github.com/DEFRA/water-abstraction-team",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "cli": "node cli/seed.cli.js",
    "open": "playwright test --ui",
    "test": "playwright test",
    "report": "playwright show-report",
    "lint": "eslint .",
    "failed": "playwright test --last-failed",
    "postinstall": "npx playwright install"
  },
  "repository": {
    "url": "https://github.com/DEFRA/water-abstraction-acceptance-tests"
  },
  "author": "Department for Environment, Food & Rural Affairs",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "big.js": "7.0.1",
    "dotenv": "17.4.2",
    "water-abstraction-engine": "github:DEFRA/water-abstraction-engine#main"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.2.0",
    "@playwright/test": "1.61.0",
    "@types/node": "26.0.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^14.0.0",
    "neostandard": "^0.12.0",
    "prettier": "3.3.3",
    "eslint-plugin-jsdoc": "^63.1.0"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "unrs-resolver@1.12.2": true
  }
}
